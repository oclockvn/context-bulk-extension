<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Sample only; not part of the release build. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the provider the way a consumer would (Core.dll is embedded in it). -->
    <ProjectReference Include="..\..\ContextBulkExtension.Postgres\ContextBulkExtension.Postgres.csproj" />
    <ProjectReference Include="..\..\ContextBulkExtension.Core\ContextBulkExtension.Core.csproj" />
  </ItemGroup>

</Project>
